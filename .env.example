# Required for MongoDB deployments; provide secrets through the deployment environment.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/DATABASE
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=3000
# Enable chain lots through ordinary purchase orders after approval (off by default).
NEXUS_ENABLE_CHAIN_LOTS=0
# Web Push is opt-in and off by default. Generate keys with web-push; never commit them.
NEXUS_ENABLE_WEB_PUSH=0
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://charlessjoyas.vercel.app
